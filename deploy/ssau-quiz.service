[Unit]
Description=SSAU quiz solver (очередь решения тестов Moodle)
PartOf=ssau.target
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/ssau-bot
EnvironmentFile=-/opt/ssau-bot/.env
ExecStart=/opt/ssau-bot/quiz
Restart=on-failure
RestartSec=5
# Остановка отдаёт незавершённые тесты обратно в очередь: даём время на возврат задач.
TimeoutStopSec=60
User=root
Group=root

[Install]
WantedBy=ssau.target
