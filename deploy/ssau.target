[Unit]
Description=SSAU lecture stack
# ssau-tunnel.service сюда не входит: remote.sh включает его (WantedBy=ssau.target)
# только без PANEL_TUNNEL=0 — на проде панель за Caddy.
Wants=ssau-tg.service ssau-rasp.service ssau-panel.service ssau-bbb.service
After=network-online.target

[Install]
WantedBy=multi-user.target
