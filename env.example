# ==========================================
# ОБЯЗАТЕЛЬНЫЕ КЛЮЧИ ТЕЛЕГРАМ
# ==========================================
# Токен бота от @BotFather (например: 123456789:AAH...)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Твой Telegram User ID (число, узнается у @userinfobot)
ADMIN_TELEGRAM_ID=1074442235

# ==========================================
# НОВЫЕ КЛЮЧИ (Fish Studio, LLM, Видео-Архив)
# ==========================================
# Ключ от Fish Studio API для распознавания речи (Speech-to-Text)
FISH_STUDIO_API_KEY=your_fish_studio_api_key_here

# URL эндпоинта Fish Studio (по умолчанию: https://api.fish.audio/v1/stt)
FISH_STUDIO_API_URL=https://api.fish.audio/v1/stt

# API ключ от LLM (OpenAI / OpenRouter / Claude) для составления отчетов
LLM_API_KEY=your_llm_api_key_here

# Базовый URL для LLM (https://api.openai.com/v1 или https://openrouter.ai/api/v1)
LLM_BASE_URL=https://api.openai.com/v1

# Название модели (gpt-4o-mini, deepseek/deepseek-chat и т.д.)
LLM_MODEL=gpt-4o-mini

# ID приватного Telegram-канала для неограниченного хранения видео (например: -1001234567890)
STORAGE_CHANNEL_ID=

# ==========================================
# НАСТРОЙКИ СЕРВЕРА И ДИСКА
# ==========================================
# Папка для сохранения видео лекций
VIDEO_RECORDINGS_DIR=recordings/video

# Папка для аудиодорожек
RECORDINGS_DIR=recordings/audio

# Лимит одновременно работающих процессов ffmpeg (1 для 4ГБ VDS)
MAX_CONCURRENT_MEDIA_JOBS=1

# База данных SQLite
DATABASE_PATH=data/bot.db

# Часовой пояс (Самара)
TZ=Europe/Samara

# Путь к Chromium (для захода на BBB)
CHROME_BIN=/usr/bin/chromium
