TELEGRAM_BOT_TOKEN=
ADMIN_TELEGRAM_ID=700000000
PANEL_PASSWORD=
# IP и CIDR через запятую, которым можно открывать панель; пусто - без фильтра.
# Если пароля нет, панель работает только при заданном списке.
PANEL_ALLOW_IPS=
# 1 - брать IP клиента из X-Forwarded-For, когда запрос пришёл с loopback (за Caddy).
PANEL_TRUST_PROXY=0
# 0 - не поднимать cloudflared-туннель (панель за своим Caddy с сертификатом).
PANEL_TUNNEL=1
# 1 - демо: панель на тестовых данных из памяти, без бота и базы.
PANEL_DEMO=0
WEBAPP_PUBLIC_URL=
WEBAPP_URL_FILE=
LISTEN_ADDR=:8080
DATABASE_PATH=data/bot.db
# Ключ шифрования паролей ЛК/Moodle (base64, 32 байта). Пусто - файл SECRET_KEY_FILE
# (по умолчанию рядом с базой, создаётся сам).
SECRET_KEY=
SECRET_KEY_FILE=
GROUP_ID=531023229
GROUP_CODE=6301-090301D
TZ=Europe/Samara
RECORDINGS_DIR=recordings
BBB_DRY_RUN=0
LECTURE_PAUSE=1
# Chromium используется только для сборки PDF конспектов (notes).
CHROME_BIN=/usr/bin/chromium
# SOCKS5 list, one login:password@ip:port per line. Each student session gets its own.
PROXY_FILE=/opt/ssau-bot/proxies.txt
LLM_API_KEY=
LLM_API_URL=
LLM_MODEL=
ASSEMBLYAI_API_KEY=
FISH_STUDIO_API_KEY=
FISH_STUDIO_API_URL=https://api.fish.audio
GROK_API_KEY=
GROK_API_URL=https://api.x.ai/v1
GROK_MODEL=grok-2-vision-1212
GROQ_API_KEY=
GROQ_API_URL=https://api.groq.com/openai/v1
GROQ_VISION_MODEL=qwen/qwen3.6-27b
GROQ_STT_MODEL=whisper-large-v3
VOSK_MODEL=/opt/ssau-bot/vosk-model
VOSK_SCRIPT=/opt/ssau-bot/wake.py
LOG_LEVEL=info
LOG_FILE=
