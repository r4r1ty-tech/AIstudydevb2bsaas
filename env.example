TELEGRAM_BOT_TOKEN=
# Telegram ID администратора (обязательно). Без него админа нет: панель «Служебное» закрыта.
ADMIN_TELEGRAM_ID=
# Вайтлист: Telegram ID через запятую или пробел. Админ добавляется сам, даже если его тут нет.
WHITELIST=
PANEL_PASSWORD=
# IP и CIDR через запятую, которым можно открывать панель; пусто - без фильтра.
# Если пароля нет, панель работает только при заданном списке.
PANEL_ALLOW_IPS=
# 1 - брать IP клиента из X-Forwarded-For, когда запрос пришёл с loopback (за Caddy).
PANEL_TRUST_PROXY=0
# 0 - не поднимать cloudflared-туннель (панель за своим Caddy с сертификатом).
PANEL_TUNNEL=1
# 1 - демо: панель на тестовых данных из памяти, без бота и базы.
PANEL_DEMO=0
WEBAPP_PUBLIC_URL=
WEBAPP_URL_FILE=
LISTEN_ADDR=:8080
DATABASE_PATH=data/bot.db
# Ключ шифрования паролей ЛК/Moodle (base64, 32 байта). Пусто - файл SECRET_KEY_FILE
# (по умолчанию рядом с базой, создаётся сам).
SECRET_KEY=
SECRET_KEY_FILE=
# Группа-якорь (обязательно): числовой groupId для публичного расписания и код группы для панели.
GROUP_ID=
GROUP_CODE=
TZ=Europe/Samara
RECORDINGS_DIR=recordings
BBB_DRY_RUN=0
LECTURE_PAUSE=1
# Typst используется только для печати PDF конспектов (notes); без него берётся typst из PATH.
TYPST_BIN=/usr/local/bin/typst
# SOCKS5 list, one login:password@ip:port per line. Each student session gets its own.
PROXY_FILE=/opt/ssau-bot/proxies.txt
# Бесплатная цепочка для тестов и конспектов: ключи Google AI Studio через запятую и OpenCode Zen.
# Ключ можно подписать владельцем: Зуев:AIza…,Пушкин:AQ.…
GEMINI_API_KEYS=
OPENCODE_API_KEYS=
# cheaperinference и т.п. — только для админа (выбор в панели).
LLM_API_KEY=
LLM_API_URL=
LLM_MODEL=
# Параметры генерации для всех запросов к моделям (пусто — значения ниже).
# LLM_REASONING_EFFORT: max (по умолчанию) — предел модели, xhigh/high/medium/
# low/minimal, off — не просить размышления вообще.
# LLM_TEMPERATURE: пусто — дефолт провайдера; 0 — детерминированно.
# LLM_MAX_TOKENS: 0/пусто — без лимита; иначе лимит токенов ответа.
# LLM_JSON_MODE=1 — response_format=json_object (кто не умеет — откат автоматически).
LLM_REASONING_EFFORT=max
LLM_TEMPERATURE=
LLM_MAX_TOKENS=0
LLM_JSON_MODE=0
# RouterHub — отдельный платный ключ админа (OpenAI-совместимый API).
# Участвует в общем консенсус-пуле тестов, но не в конспектах и STT.
# GLM 5.3 — средний баланс ($0.15/$0.47 за 1M), qwen3.8-max — запасной.
ROUTERHUB_API_KEY=
ROUTERHUB_API_URL=https://routerhub.si/v1
ROUTERHUB_MODEL=glm-5.3
# Модель расшифровки аудио у cheaper (POST {LLM_API_URL}/audio/transcriptions), см. docs/OPERATIONS.md.
CHEAPER_STT_MODEL=whisper-large-v3-turbo
# Deepgram: расшифровка аудио, первый провайдер STT, до пула Gemini. Без ключа пропускается.
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
ASSEMBLYAI_API_KEY=
FISH_STUDIO_API_KEY=
FISH_STUDIO_API_URL=https://api.fish.audio
GROK_API_KEY=
GROK_API_URL=https://api.x.ai/v1
GROK_MODEL=grok-2-vision-1212
GROQ_API_KEY=
GROQ_API_URL=https://api.groq.com/openai/v1
GROQ_VISION_MODEL=qwen/qwen3.6-27b
GROQ_STT_MODEL=whisper-large-v3

# Веб-поиск решателя тестов: цепочка Tavily → Exa → SearXNG → DuckDuckGo lite.
# Без ключей работает только DuckDuckGo (бесплатно, но с серверов может резать).
# Tavily: бесплатно 1000 запросов/мес, ключ на app.tavily.com.
TAVILY_API_KEY=
EXA_API_KEY=
SEARXNG_URL=
WEBSEARCH=1
WEBSEARCH_DDG=1
# Решение тестов Moodle. service — тесты ставятся в очередь в базе, решает сервис ssau-quiz
# (по умолчанию и в проде). inline — решает пул в процессе rasp (локальная разработка).
QUIZ_MODE=service
# Сколько тестов ssau-quiz решает одновременно (у каждого свой ключ ИИ).
QUIZ_MAX_PARALLEL=50
# Входов и стартов попыток Moodle в секунду на весь процесс ssau-quiz.
QUIZ_MOODLE_RPS=3
# Только для QUIZ_MODE=inline: сколько тестов решает пул rasp.
MOODLE_QUIZ_WORKERS=4
# Консенсус тестов: минимум разных API-ключей из общего пула на один вопрос.
# Ответ выбирается, если за него >= 50% голосов и он строго лидирует. Нет
# консенсуса — берём следующий ключ. 0 — выключить, решать одной цепочкой.
QUIZ_CONSENSUS=3
# Максимум ключей, которые перебираем, если консенсуса всё нет.
QUIZ_CONSENSUS_MAX=9
# Доля голосов, нужная ответу, в процентах. 66 — две трети: 2 из 3 хватает,
# 3 из 5 уже нет, вопрос добирает следующий ключ.
QUIZ_CONSENSUS_SHARE=66
# Минимальная уверенность модели (0..1), чтобы принять ответ без единогласия.
# 0 — не смотреть на confidence, решает только доля голосов.
QUIZ_CONFIDENCE_MIN=0.5
VOSK_MODEL=/opt/ssau-bot/vosk-model
VOSK_SCRIPT=/opt/ssau-bot/wake.py
LOG_LEVEL=info
LOG_FILE=
# Подробный лог отладки: каждый процесс пишет ВСЁ (включая debug) в
# LOG_DIR/<процесс>.log независимо от LOG_LEVEL; ротация по LOG_DEBUG_MAX_MB,
# хранится LOG_DEBUG_KEEP сжатых кусков. Снимки страниц тестов, промптов и
# ответов ИИ — LOG_DIR/dumps, общий потолок LOG_DUMP_MAX_MB. LOG_DEBUG=0 — выключить.
LOG_DEBUG=1
LOG_DIR=logs
LOG_DEBUG_MAX_MB=50
LOG_DEBUG_KEEP=20
LOG_DUMP_MAX_MB=500
