{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "**/.ssh/**": "deny",
      "**/id_ed25519*": "deny",
      "**/id_rsa*": "deny",
      "**/*.pem": "deny"
    },
    "external_directory": {
      "~/.ssh/**": "deny"
    },
    "bash": {
      "*": "allow",
      "ssh *": "ask",
      "ssh ssau *": "deny",
      "ssh ssau status*": "allow",
      "ssh ssau units*": "allow",
      "ssh ssau logs *": "allow",
      "ssh ssau webapp-url*": "allow",
      "ssh ssau env-keys*": "allow",
      "ssh ssau recordings*": "allow",
      "ssh ssau disk*": "allow",
      "ssh ssau test": "allow",
      "ssh ssau test *": "allow",
      "ssh ssau test-name*": "allow",
      "ssh ssau test-dummy*": "allow",
      "ssh ssau test-listen*": "allow",
      "ssh ssau test-leave*": "allow",
      "ssh ssau test-log-level*": "allow",
      "ssh ssau logs-grep*": "allow",
      "ssh ssau sinks*": "allow",
      "ssh ssau sink-inputs*": "allow",
      "ssh ssau procs*": "allow",
      "ssh ssau proxies-status*": "allow",
      "ssh ssau proxies-set*": "allow",
      "ssh ssau proxies-clear*": "allow",
      "ssh ssau restart *": "ask",
      "scp *": "ask",
      "* ~/.ssh*": "deny",
      "*/.ssh/*": "deny",
      "*ssau_agent_ed25519*": "deny",
      "*id_ed25519*": "deny",
      "*id_rsa*": "deny",
      "*.pem": "deny",
      "*.pem *": "deny",
      "*.env": "deny",
      "*.env *": "deny",
      "*.env.*": "deny"
    }
  }
}